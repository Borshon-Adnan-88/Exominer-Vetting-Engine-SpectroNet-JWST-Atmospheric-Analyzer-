    koi_fpflag_nt,
    koi_fpflag_ss,
    koi_fpflag_co,
    koi_fpflag_ec,
    koi_disp_prov,
    koi_comment,
    koi_vet_stat,
    koi_vet_date,
    koi_tce_plnt_num,
    koi_tce_delivname,
    koi_period,
    koi_time0bk,
    koi_duration,
    koi_depth,
    koi_model_snr,
    koi_max_mult_ev,
